# Guild HQ server secrets — copy to /etc/guildhq.env, then:
#   sudo chown root:root /etc/guildhq.env && sudo chmod 600 /etc/guildhq.env
#
# The two passwords MUST differ — the server refuses to start otherwise.
# Use long random values (e.g. `openssl rand -base64 18` for each).
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
VIEWER_PASSWORD=REPLACE_WITH_DIFFERENT_VIEWER_PASSWORD

# Optional overrides (defaults shown; the systemd unit already sets sane values):
# PORT=8321
# HOST=127.0.0.1
# COOKIE_SECURE=true
# SESSION_DAYS=30
